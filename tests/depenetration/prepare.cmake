if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Set OUTPUT_DIR")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../vphysics_jolt/vjolt_object.cpp" SOURCE)
set(BEGIN "bool JoltPhysicsObject::CanRecoverContactPenetration() const")
set(END "void JoltPhysicsObject::SaveObjectState(")
string(FIND "${SOURCE}" "${BEGIN}" BEGIN_POS)
string(FIND "${SOURCE}" "${END}" END_POS)
if(BEGIN_POS LESS 0 OR END_POS LESS BEGIN_POS)
    message(FATAL_ERROR "Contact recovery eligibility source boundaries not found")
endif()
math(EXPR LENGTH "${END_POS} - ${BEGIN_POS}")
string(SUBSTRING "${SOURCE}" ${BEGIN_POS} ${LENGTH} FUNCTION)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/eligibility.inc" "${FUNCTION}")
